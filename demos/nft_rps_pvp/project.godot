; Neon Clash — Browser-first Redot RPS PvP prototype
; No blockchain, wallet SDK, cryptocurrency, or real-money settlement is included.

config_version=5

[application]
config/name="Neon Clash: NFT RPS"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.3")

[display]

[display/window]
size/viewport_width=1440
size/viewport_height=900
size/window_width_override=1440
size/window_height_override=900
stretch/mode="canvas_items"
handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false

audio/driver/enable_input=false

[gui]
theme/default_font_multichannel_signed_distance_field=true
